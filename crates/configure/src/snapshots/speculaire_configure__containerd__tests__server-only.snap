---
source: crates/configure/src/containerd.rs
expression: out
---
server = "https://registry.example:5000"
ca = "/etc/ssl/registry.crt"

# Added by `speculaire configure`; `speculaire unconfigure` removes it.
[host."https://127.0.0.1:7480"]
  capabilities = ["pull"]
  ca = "/var/lib/speculaire/mirror/ca.crt"
  client = "/var/lib/speculaire/mirror/client.pem"
  dial_timeout = "200ms"
