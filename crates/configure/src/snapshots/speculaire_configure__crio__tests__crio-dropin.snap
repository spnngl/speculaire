# Written by `speculaire configure`; `speculaire unconfigure` removes it (D66).

[[registry]]
prefix = "*.rewritten.example"
location = "rewritten.corp"

[[registry.mirror]]
location = "127.0.0.1:7480/rewritten.corp"
pull-from-mirror = "all"

