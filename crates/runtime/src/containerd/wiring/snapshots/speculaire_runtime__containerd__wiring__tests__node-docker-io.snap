---
source: crates/configure/src/tests.rs
expression: "docker.replace(node.dir.path().to_str().unwrap(), \"<root>\")"
---
# docker.io, through the corporate proxy
server = "https://registry-1.docker.io"

# Added by `speculaire configure`; `speculaire unconfigure` removes it.
[host."https://127.0.0.1:7480"]
  capabilities = ["pull"]
  ca = "<root>/var/lib/speculaire/mirror/ca.crt"
  client = "<root>/var/lib/speculaire/mirror/client.pem"
  dial_timeout = "200ms"

[host."https://proxy.corp"]
  capabilities = ["pull", "resolve"]
