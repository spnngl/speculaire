# The containerd node image of the e2e suites (D59, D63): a kindest/node with its containerd replaced by a release,
# and the two settings speculaire needs patched in. `just e2e-up containerd <minor> [<kubernetes minor>]` passes NODE
# (the digest-pinned kindest/node of the Kubernetes minor) and RELEASE.
# Ported from the M0 spike harness (D27, Measured).
ARG NODE

FROM docker.io/library/alpine:3.23@sha256:469c9ea410b9215eaee7976ba6c0639039b444be8e5d638f7abbada189971eb2 AS download
ARG RELEASE
ARG TARGETARCH
RUN apk add --no-cache curl
WORKDIR /download
RUN f="containerd-${RELEASE}-linux-${TARGETARCH}.tar.gz" \
    && u="https://github.com/containerd/containerd/releases/download/v${RELEASE}" \
    && curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 10 \
        --remote-name-all "$u/$f" "$u/$f.sha256sum" \
    && sha256sum -c "$f.sha256sum" && mkdir out && tar -xzf "$f" -C out

FROM ${NODE}
# The node keeps containerd in /usr/local/bin; the tarball's bin/ has the same names.
COPY --from=download /download/out/bin/containerd /download/out/bin/containerd-shim-runc-v2 /download/out/bin/ctr \
    /usr/local/bin/
# The node image drops layers from the content store after unpack, which the gate's preflight refuses (D15), and has
# no `config_path`, which the mirror needs (D14). The build fails when the patch no longer applies.
RUN sed -i 's/discard_unpacked_layers = true/discard_unpacked_layers = false/' /etc/containerd/config.toml \
    && grep -q 'discard_unpacked_layers = false' /etc/containerd/config.toml \
    && printf '\n[plugins."io.containerd.grpc.v1.cri".registry]\n  config_path = "/etc/containerd/certs.d"\n' \
        >> /etc/containerd/config.toml
# kindest/node ships /etc/containerd as 0644, a directory the agent cannot enter: it runs as root without capabilities
# (D53), and its preflight reads config.toml (D86).
RUN chmod 0755 /etc/containerd
