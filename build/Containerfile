# The build image (D57): every recipe on macOS through `just dev`, and the static musl binaries through `just musl`
# (D13), natively on the architecture of the machine running it.
#
#   build    the toolchain, lld and cargo-auditable: just musl
#   dev      plus just and the tools of `just check` and the dependency checks: just dev <recipe>
#   profile  glibc, perf, Valgrind and inferno: just profile <target>, just valgrind (D116)

# The tag is rust-toolchain.toml's channel; Renovate keeps the digest.
FROM docker.io/library/rust:1.99.1-alpine@sha256:44819b27be4c97b0e4d7203bd2e02c4820f97700211b6a37fb4c246a2de59383 AS build

# lld: Alpine's own, see `.cargo/lld-cc`; build-base: mimalloc's C (D46); bash: the justfile's shell; file: `just musl`
# checks the binary is static-pie; protobuf-dev: protoc and its well-known types, for the protobuf exposition of
# `/metrics` (D34).
RUN apk add --no-cache bash build-base file git lld protobuf-dev
# rust-toolchain.toml's components; the image's minimal profile lacks them, and rustup would fetch them on every run.
RUN rustup component add clippy llvm-tools rustfmt

# renovate: datasource=crate depName=cargo-auditable
ARG CARGO_AUDITABLE_VERSION=0.7.7
# renovate: datasource=crate depName=rust-audit-info
ARG RUST_AUDIT_INFO_VERSION=0.5.4
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install --locked cargo-auditable@"$CARGO_AUDITABLE_VERSION" rust-audit-info@"$RUST_AUDIT_INFO_VERSION"

# Constant time: mimalloc's `options.c` embeds `__DATE__` and `__TIME__`, which gcc takes from this variable (D46).
# `.cargo/config.toml` remaps the paths.
ENV SOURCE_DATE_EPOCH=0
WORKDIR /src

FROM build AS dev

# The justfile's `nightly`, passed by `just dev`: rustfmt.toml uses unstable options, and `just minimal-versions` a
# `-Z` flag.
ARG NIGHTLY
RUN rustup toolchain install "$NIGHTLY" --profile minimal --component rustfmt

# renovate: datasource=crate depName=just
ARG JUST_VERSION=1.59.0
# renovate: datasource=crate depName=taplo-cli
ARG TAPLO_VERSION=0.10.0
# renovate: datasource=crate depName=typos-cli
ARG TYPOS_VERSION=1.51.1
# renovate: datasource=crate depName=cargo-shear
ARG CARGO_SHEAR_VERSION=1.14.0
# renovate: datasource=crate depName=cargo-hack
ARG CARGO_HACK_VERSION=0.6.45
# renovate: datasource=crate depName=cargo-deny
ARG CARGO_DENY_VERSION=0.20.2
# renovate: datasource=crate depName=cargo-vet
ARG CARGO_VET_VERSION=0.10.3
# renovate: datasource=crate depName=cargo-nextest
ARG CARGO_NEXTEST_VERSION=0.9.151
# renovate: datasource=crate depName=cargo-llvm-cov
ARG CARGO_LLVM_COV_VERSION=0.9.1
# cargo-vet links zlib statically through libz-sys.
RUN apk add --no-cache zlib-static
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install --locked just@"$JUST_VERSION" taplo-cli@"$TAPLO_VERSION" typos-cli@"$TYPOS_VERSION" \
        cargo-shear@"$CARGO_SHEAR_VERSION" cargo-hack@"$CARGO_HACK_VERSION" cargo-deny@"$CARGO_DENY_VERSION" \
        cargo-vet@"$CARGO_VET_VERSION" cargo-nextest@"$CARGO_NEXTEST_VERSION" \
        cargo-llvm-cov@"$CARGO_LLVM_COV_VERSION"


# perf and Valgrind follow glibc's allocator and the frame pointers of a glibc build, where Valgrind does not follow the
# static musl binary's (D46). The tag is rust-toolchain.toml's channel; Renovate keeps the digest.
FROM docker.io/library/rust:1.99.1-slim-trixie@sha256:f6c4a35d21dbb3c89d7a8d056c193e94fc09037f2b58dd858b09c39a47dd02d7 AS profile

# linux-perf: the sampler of `just profile`; procps: `kill`, with which the load stops agents; protobuf-compiler and
# libprotobuf-dev: protoc and its well-known types (D34). `unshare` and `mount`, for the peer pull's holder, are in the
# base image.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libprotobuf-dev linux-perf procps protobuf-compiler valgrind \
    && rm -rf /var/lib/apt/lists/*
# rust-toolchain.toml's components, which rustup would otherwise fetch at the first build.
RUN rustup component add clippy llvm-tools rustfmt

# inferno draws the flamegraphs; rustfilt demangles Rust's v0 symbols, which this perf prints mangled.
# renovate: datasource=crate depName=inferno
ARG INFERNO_VERSION=0.12.8
# renovate: datasource=crate depName=rustfilt
ARG RUSTFILT_VERSION=0.2.2
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install --locked inferno@"$INFERNO_VERSION" rustfilt@"$RUSTFILT_VERSION"
WORKDIR /src
