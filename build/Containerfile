# The build image (D57): every recipe on macOS through `just dev`, and the static musl binaries through `just musl`
# (D13), natively on the architecture of the machine running it.
#
#   build  the toolchain, lld and cargo-auditable: just musl
#   dev    plus the tools of `just check` and the dependency checks: just dev <recipe>

# The tag is rust-toolchain.toml's channel; Renovate keeps the digest.
FROM docker.io/library/rust:1.99.1-alpine@sha256:44819b27be4c97b0e4d7203bd2e02c4820f97700211b6a37fb4c246a2de59383 AS build

# lld: Alpine's own, see `.cargo/lld-cc`; build-base: mimalloc's C (D46); bash: the justfile's shell.
RUN apk add --no-cache bash build-base git lld
# rust-toolchain.toml's components; the image's minimal profile lacks them, and rustup would fetch them on every run.
RUN rustup component add clippy rustfmt

# renovate: datasource=crate depName=just
ARG JUST_VERSION=1.59.0
# renovate: datasource=crate depName=cargo-auditable
ARG CARGO_AUDITABLE_VERSION=0.7.7
# renovate: datasource=crate depName=rust-audit-info
ARG RUST_AUDIT_INFO_VERSION=0.5.4
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install --locked just@"$JUST_VERSION" cargo-auditable@"$CARGO_AUDITABLE_VERSION" \
        rust-audit-info@"$RUST_AUDIT_INFO_VERSION"

# Constant time: mimalloc's `options.c` embeds `__DATE__` and `__TIME__`, which gcc takes from this variable (D46).
# `.cargo/config.toml` remaps the paths.
ENV SOURCE_DATE_EPOCH=0
WORKDIR /src

FROM build AS dev

# The justfile's `nightly`, passed by `just dev`: rustfmt.toml uses unstable options, and `just minimal-versions` a
# `-Z` flag.
ARG NIGHTLY
RUN rustup toolchain install "$NIGHTLY" --profile minimal --component rustfmt

# renovate: datasource=crate depName=taplo-cli
ARG TAPLO_VERSION=0.10.0
# renovate: datasource=crate depName=typos-cli
ARG TYPOS_VERSION=1.51.1
# renovate: datasource=crate depName=cargo-shear
ARG CARGO_SHEAR_VERSION=1.14.0
# renovate: datasource=crate depName=cargo-hack
ARG CARGO_HACK_VERSION=0.6.45
# renovate: datasource=crate depName=cargo-deny
ARG CARGO_DENY_VERSION=0.20.2
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install --locked taplo-cli@"$TAPLO_VERSION" typos-cli@"$TYPOS_VERSION" \
        cargo-shear@"$CARGO_SHEAR_VERSION" cargo-hack@"$CARGO_HACK_VERSION" cargo-deny@"$CARGO_DENY_VERSION"
